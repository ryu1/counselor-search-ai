{
  "name": "CounselorSearchAI",
  "version": 1,
  "runtimes": [
    {
      "name": "counselor_search_agent",
      "description": "Counselor search AI agent",
      "build": "CodeZip",
      "entrypoint": "app.py:main",
      "codeLocation": "app",
      "runtimeVersion": "PYTHON_3_11",
      "networkMode": "PUBLIC",
      "instrumentation": {
        "enableOtel": false
      },
      "envVars": [
        {
          "name": "LAMBDA_FUNCTION_NAME",
          "value": "search_counselors"
        },
        {
          "name": "AGENTCORE_MEMORY_ID",
          "value": "CounselorSearchAI_session_memory-s7sxexEu5z"
        }
      ]
    }
  ],
  "memories": [
    {
      "name": "session_memory",
      "description": "Session memory for conversation history",
      "type": "SHORT_TERM",
      "defaultRetentionMinutes": 60,
      "eventExpiryDuration": 24
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": []
}
